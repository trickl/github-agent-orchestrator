# GitHub Agent Orchestrator (Phase 1/1A)
# Copy this file to .env and fill in values.

# GitHub authentication
ORCHESTRATOR_GITHUB_TOKEN=ghp_your_token_here
GITHUB_BASE_URL=https://api.github.com

# Local control-plane backend (backend/app)
# GitHub App credentials used for backend GitHub API calls.
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Optional fixed installation id; when omitted, backend resolves installation by repo.
GITHUB_APP_INSTALLATION_ID=
# Optional app slug used to construct install URL for onboarding UI.
GITHUB_APP_SLUG=github-agent-orchestrator
# Optional explicit install URL override (takes precedence over slug).
GITHUB_APP_INSTALL_URL=
# Optional override: defaults to true (recommended).
# Set to false only for local/dev auth bypass.
# BACKEND_REQUIRE_AUTH=true
# GitHub OAuth app used for end-user sign-in to the web UI.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://github-agent-orchestrator.onrender.com/auth/github/callback
# Frontend URL to redirect to after OAuth callback.
AUTH_FRONTEND_REDIRECT_URL=https://trickl.github.io/github-agent-orchestrator/
# Secret used to sign backend session cookies.
AUTH_SESSION_SECRET=replace-with-long-random-secret
# Optional comma-separated user allowlist (GitHub logins). Empty = any authenticated user.
AUTH_ALLOWED_GITHUB_USERS=trickl
# Session lifetime in seconds (default 7 days)
AUTH_SESSION_MAX_AGE_SECONDS=604800
# Optional override: defaults to true (recommended).
# Set to false only for non-HTTPS local testing.
# AUTH_COOKIE_SECURE=true
# Optional API base override (GitHub Enterprise, etc.)
GITHUB_API_URL=https://api.github.com
# Allowed browser origins for backend CORS (comma-separated)
CORS_ORIGINS=https://trickl.github.io,http://localhost:5173,http://127.0.0.1:5173
# Optional workflow file name used by /start, /stop, /status (legacy endpoints)
GITHUB_ORCHESTRATOR_WORKFLOW_FILE=orchestrator.yml
# Webhook signature verification secret for /webhooks/github
GITHUB_WEBHOOK_SECRET=
# Optional local CLI binary/command used by POST /repos/{owner}/{repo}/run
GAO_CLI_COMMAND=gao
# Optional timeout (seconds) for local CLI run endpoint
GAO_RUN_TIMEOUT_SECONDS=1800

# Logging
LOG_LEVEL=INFO

# Local persistence
AGENT_STATE_PATH=agent_state

# REST server (optional)
# The server needs a default repo for PR monitoring because Phase 1 state does not
# yet store per-issue repository.
ORCHESTRATOR_DEFAULT_REPO=owner/repo
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8000

# Server-side auto progression (optional)
# When enabled, the server will periodically attempt deterministic loop actions:
# - Step A: ensure a gap analysis issue exists and is assigned (if none exists)
# - Step B: promote next unpromoted development queue file
# - Step D: merge next ready development PR
# - Step E (legacy): promote next unpromoted capability queue file
# - Step G: merge next ready capability PR
ORCHESTRATOR_AUTO_PROMOTE_ENABLED=false
ORCHESTRATOR_AUTO_PROMOTE_INTERVAL_SECONDS=30

# Assignment hygiene (optional)
# Remove non-Copilot assignees when auto-assigning, except for issues with these labels.
ORCHESTRATOR_PRUNE_NON_COPILOT_ASSIGNEES=true
ORCHESTRATOR_NON_COPILOT_ASSIGNEE_LABELS=Development

# Target repo branch control (optional)
# Explicit base branch for Copilot work. Leave empty to use the repo default.
ORCHESTRATOR_TARGET_BASE_BRANCH=
# Create a dedicated work branch per issue (safer default).
ORCHESTRATOR_CREATE_WORK_BRANCH=true
# Prefix for per-issue work branches (e.g., orchestrator/work/issue-123)
ORCHESTRATOR_WORK_BRANCH_PREFIX=orchestrator/work

# Cost estimates (conservative defaults)
# Premium request cost and iteration assumptions (see docs/costing.md).
ORCHESTRATOR_PREMIUM_REQUEST_COST_USD=0.04
ORCHESTRATOR_ESTIMATED_PREMIUM_REQUESTS_PER_PR=1
ORCHESTRATOR_ESTIMATED_PRS_PER_ITERATION=3

# Copilot job error inspection (optional)
# Requires a GitHub token with actions:read
ORCHESTRATOR_INCLUDE_COPILOT_JOB_ERRORS=false
ORCHESTRATOR_COPILOT_JOB_ERROR_MAX_LINES=5
